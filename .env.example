# Database (set these for standalone MySQL; Railway auto-provides MYSQLHOST, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moodtracker
DB_USER=root
DB_PASS=

# Mail Driver
# Set MAIL_MAILER=brevo to use Brevo API, or omit/set to 'smtp' for SMTP
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=MoodTrail

# reCAPTCHA (register only)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# App URL (set for production, leave empty for local auto-detection)
APP_URL=
